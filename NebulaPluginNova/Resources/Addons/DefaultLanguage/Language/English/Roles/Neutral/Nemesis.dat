"options.role.nemesis.numOfGuessPerMeeting" : "Guesses per Meeting"
"options.role.nemesis.numOfMissAllowed" : "Allowed Misses"
"options.role.nemesis.disableGuessAfterMiss" : "Cannot Guess after a Miss in the Same Meeting"

