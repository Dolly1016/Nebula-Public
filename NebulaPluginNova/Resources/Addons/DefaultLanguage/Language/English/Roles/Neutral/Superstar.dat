# Assignable

"role.superstar.name" : "Superstar"
"role.superstar.short" : "SS"
"role.superstar.blurb" : "Tonight's star sweeps up the world"

# Document

"role.superstar.doc" : "A neutral role that sweeps every player into random effects with dances."
"role.superstar.winCond" : "Dance successfully <var>%NUM%</var> times."
"role.superstar.ability.title" : "Unique Ability "Stage Jack""
"role.superstar.ability.main" : "The Superstar can dance by moving in small steps.<br>Every time the Superstar keeps dancing for <var>%TIME%</var> seconds, a random effect is triggered on all players."
"role.superstar.ability.dance" : "<title>Dance</title>Keep moving in small steps on the spot to dance. It <b>cannot be activated</b> by clicking the button or pressing a key.<br>Dance until the button's timer fills up to trigger a random effect on all players."

